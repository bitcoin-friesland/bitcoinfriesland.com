root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# Preserve intentional Markdown hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Generated stylesheet: do not reformat or hand-edit.
[assets/styles.css]
insert_final_newline = unset
indent_style = unset
indent_size = unset
